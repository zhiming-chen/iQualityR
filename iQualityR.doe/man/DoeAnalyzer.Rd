\item{\code{max_effect}}{Numeric scalar, the maximum effect size to plot.
Defaults to \code{4 * sigma}.}

\item{\code{n_points}}{Integer scalar, the number of curve points.}
}
\if{html}{\out{</div>}}
}
\subsection{Returns}{
A data frame with columns \code{Effect_Size}, \code{Power},
\code{Effect_to_Sigma_Ratio}, and \code{Target} (the 0.80 reference).
}
}
\if{html}{\out{<hr>}}
\if{html}{\out{<a id="method-DoeAnalyzer-ridge_analysis"></a>}}
\if{latex}{\out{\hypertarget{method-DoeAnalyzer-ridge_analysis}{}}}
\subsection{Method \code{ridge_analysis()}}{
Perform ridge analysis on a fitted second-order RSM
model. Computes the optimum of the predicted response on a series
of hyperspheres of increasing radius, starting from the design
center. Used when the stationary point is outside the design region
or is a saddle point.
\subsection{Usage}{
\if{html}{\out{<div class="r">}}\preformatted{DoeAnalyzer$ridge_analysis(
  model,
  factor_names,
  maximize = TRUE,
  max_radius = NULL,
  n_radii = 20
)}\if{html}{\out{</div>}}
}

\subsection{Arguments}{
\if{html}{\out{<div class="arguments">}}
\describe{
\item{\code{model}}{A fitted \code{lm} object with a second-order formula.}

\item{\code{factor_names}}{Character vector of factor names.}

\item{\code{maximize}}{Logical. If \code{TRUE} (default), find the ridge of
steepest ascent; if \code{FALSE}, the ridge of steepest descent.}

\item{\code{max_radius}}{Numeric scalar, the maximum radius to explore.
Defaults to \code{sqrt(k)} (the corner of the design cube).}

\item{\code{n_radii}}{Integer scalar, the number of radii to evaluate.}
}
\if{html}{\out{</div>}}
}
\subsection{Returns}{
A data frame with one row per radius, containing the coded
factor values, the radius, the predicted response, and the Lagrange
multiplier. An attribute \code{"nature"} indicates whether the
stationary point is inside (\code{"inside"}) or outside (\code{"outside"})
the design region.
}
}
\if{html}{\out{<hr>}}
\if{html}{\out{<a id="method-DoeAnalyzer-create_optimal_design"></a>}}
\if{latex}{\out{\hypertarget{method-DoeAnalyzer-create_optimal_design}{}}}
\subsection{Method \code{create_optimal_design()}}{
Construct an optimal design via the coordinate-exchange
algorithm (Meyer & Nachtsheim 1995). Supports D-, A-, and
I-optimality criteria. The design is built in coded space (from -1
to +1) and then converted to the actual factor levels.
\subsection{Usage}{
\if{html}{\out{<div class="r">}}\preformatted{DoeAnalyzer$create_optimal_design(
  factors,
  n_runs,
  model_order = "main",
  criterion = "D",
  n_levels = 5L,
  n_iter = 20L,
  n_starts = 10L,
  seed = NULL
)}\if{html}{\out{</div>}}
}

\subsection{Arguments}{
\if{html}{\out{<div class="arguments">}}
\describe{
\item{\code{factors}}{List of factor definitions (each with \code{name}, \code{type},
\code{levels}).}

\item{\code{n_runs}}{Integer. Number of runs in the design.}

\item{\code{model_order}}{Character. Model expanded when building the model
matrix: \code{"main"} (main effects only), \code{"interaction"} (main + 2FI),
or \code{"quadratic"} (full second-order).}

\item{\code{criterion}}{Character. Optimality criterion: \code{"D"}, \code{"A"}, or
\code{"I"}.}

\item{\code{n_levels}}{Integer. Number of candidate levels per factor in the
coordinate-exchange grid (default 5).}

\item{\code{n_iter}}{Integer. Maximum number of coordinate-exchange sweeps
(default 20).}

\item{\code{n_starts}}{Integer. Number of random restarts (default 10). The
best design across restarts is returned.}

\item{\code{seed}}{Optional random seed for reproducibility.}
}
\if{html}{\out{</div>}}
}
\subsection{Returns}{
A list with \code{design} (data frame in actual factor levels),
\code{criterion} (the achieved criterion value), \code{criterion_name},
\code{model_order}, \code{n_iter_run}, \code{X} (the final model matrix), and
\code{history} (criterion value per iteration of the best restart).
}
}
