and the response.}

\item{\code{control_factors}}{Character vector of control-factor column names.}

\item{\code{signal_factor}}{Character scalar giving the signal-factor column.}

\item{\code{response}}{Character scalar giving the response column.}

\item{\code{type}}{Character scalar giving the dynamic model:
\code{"zero_point"} or \code{"linear"}.}
}
\if{html}{\out{</div>}}
