\subsection{Method \code{bootstrap_ci()}}{
Bootstrap confidence interval for a scalar statistic

Draws \code{R} bootstrap resamples (with replacement) from \code{data}, recomputes
\code{statistic(data)} on each resample, and returns a confidence interval
for the population value of the statistic. Four interval methods are
supported:
\itemize{
\item \code{"bca"} (default): bias-corrected and accelerated -- the most
accurate general-purpose bootstrap CI. Uses jackknife acceleration
and bias-correction via the inverse-normal transform.
\item \code{"perc"}: percentile interval -- takes empirical quantiles of the
bootstrap distribution.
\item \code{"basic"}: basic / pivotal interval -- \code{2*theta_hat - quantile}.
\item \code{"norm"}: normal approximation -- \verb{theta_hat +/- z * se_boot}.
}
\subsection{Usage}{
\if{html}{\out{<div class="r">}}\preformatted{ResamplingAnalyzer$bootstrap_ci(
  statistic,
  data,
  R = 9999,
  conf_level = 0.95,
  method = c("bca", "perc", "basic", "norm"),
  alternative = "two.sided",
  seed = NULL
)}\if{html}{\out{</div>}}
}

\subsection{Arguments}{
\if{html}{\out{<div class="arguments">}}
\describe{
\item{\code{statistic}}{A function that takes \code{data} (a data frame or vector
of the same type as \code{data}) and returns a single numeric scalar.}

\item{\code{data}}{The sample data. Either a data frame (rows are resampled)
or a numeric vector (elements are resampled).}

\item{\code{R}}{Number of bootstrap replicates (default 9999).}

\item{\code{conf_level}}{Confidence level (default 0.95).}

\item{\code{method}}{Interval method: \code{"bca"} (default), \code{"perc"}, \code{"basic"},
\code{"norm"}.}

\item{\code{alternative}}{Direction: \code{"two.sided"} (default), \code{"less"},
