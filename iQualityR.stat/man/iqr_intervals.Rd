set.seed(123)
y <- rnorm(30, mean = 102, sd = 5)
iv$run("ci_diff_mean", x = x, y = y)

# Plotting requires the iQualityR.plot Suggests package
if (requireNamespace("iQualityR.plot", quietly = TRUE)) {
