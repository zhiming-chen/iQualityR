\subsection{Method \code{spline_fit()}}{
Fit a spline regression model (B-spline / natural spline)

Wraps \code{\link[stats:lm]{stats::lm()}} with a spline basis on the primary predictor.
The response is modelled as \verb{y ~ <basis>(x, df)} where \verb{<basis>} is
\code{splines::bs} (B-spline, default) or \code{splines::ns} (natural spline).
Additional covariates may be added via the formula's right-hand side.
\subsection{Usage}{
\if{html}{\out{<div class="r">}}\preformatted{RegressionAnalyzer$spline_fit(
  formula,
  data,
  df = 4,
  basis = c("bs", "ns"),
  knots = NULL,
  degree = 3,
  subset = NULL,
  weights = NULL,
  na.action = stats::na.omit
)}\if{html}{\out{</div>}}
}

\subsection{Arguments}{
\if{html}{\out{<div class="arguments">}}
\describe{
\item{\code{formula}}{A model formula. The first predictor on the RHS is
expanded with the spline basis (e.g. \code{y ~ x + z} becomes
\code{y ~ bs(x, df) + z}).}

\item{\code{data}}{A data frame.}

\item{\code{df}}{Degrees of freedom (number of basis parameters). Default 4.}

\item{\code{basis}}{\code{"bs"} (B-spline, default) or \code{"ns"} (natural spline).}

\item{\code{knots}}{Optional explicit knot positions. Overrides \code{df} when given.}

\item{\code{degree}}{B-spline degree (only used for \code{basis = "bs"}). Default 3.}

\item{\code{subset}}{Optional subset expression.}

\item{\code{weights}}{Optional prior weights.}

\item{\code{na.action}}{NA handling.}
}
\if{html}{\out{</div>}}
}
\subsection{Returns}{
A stat_result S3 object.
}
}
